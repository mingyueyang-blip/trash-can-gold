# 炼金炉 · 环境变量示例
# 复制为 .env 并填入真实值

# API 鉴权（与 iflow/快捷指令 请求头 X-API-KEY 一致）
API_KEY=your-secret-api-key
# 前端调用 /api 时使用（单用户可填与 API_KEY 相同）
NEXT_PUBLIC_API_KEY=your-secret-api-key

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 通义千问（阿里云 DashScope，用于 AI 打标）
# 获取：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxx

# Jina Reader（链接抓取，可选；无 key 时有限流）
# 获取：https://jina.ai/reader
JINA_API_KEY=your-jina-api-key
